# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal app (developer.paypal.com > Apps & Credentials > Sandbox > your app)
# Under Features tick "Customer disputes" and "Transaction search".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default. For a live account use https://api-m.paypal.com (and set APP_PASSWORD).
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Google Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is busy (503/429) or retired (404).
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest

# Supabase database (optional but recommended: keeps cases, analyses and activity across restarts and deploys)
# 1) Supabase > SQL Editor: run supabase/schema.sql once.  2) Supabase > Project Settings > API Keys.
SUPABASE_URL=
# A secret key (sb_secret_...) is best; a publishable key (sb_publishable_...) works with the policies in schema.sql.
SUPABASE_KEY=


# Merchant context the AI uses
STORE_NAME=Northwind Goods
STORE_CURRENCY=USD
# STORE_POLICY=Returns accepted within 30 days of delivery...

# Optional
PORT=3000
# Password for the dashboard. Required before write actions on live PayPal; recommended on any public URL.
# APP_PASSWORD=
# Public https URL. Used for PayPal return links and to register the dispute webhook automatically.
# Render sets RENDER_EXTERNAL_URL, which is used when PUBLIC_URL is empty.
# PUBLIC_URL=https://your-app.onrender.com
# Use an existing PayPal webhook instead of registering one.
# PAYPAL_WEBHOOK_ID=
# Self-ping so free hosts (Render free plan) never sleep. Automatic on Render; true/false to force.
# KEEP_ALIVE=true
# KEEP_ALIVE_SECONDS=600
# Background check for new disputes (seconds) and automatic AI analysis of new ones.
# POLL_SECONDS=60
# AUTO_ANALYZE=true
# Where data/store.json lives (Render: a persistent disk mount, if you add one).
# DATA_DIR=./data
